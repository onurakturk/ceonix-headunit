<?xml version="1.0" encoding="utf-8"?><!--
    Laid out for the landscape screen this runs on. The three points sit side by side rather than
    stacked, because the height is what is scarce here and the width is not: a head unit in
    landscape has ~330-360dp of usable height, and stacking three paragraphs plus a tall header
    and a footer needed well over 500dp, so the rider had to scroll a screen they are being asked
    to read. Across the columns the tallest point decides the height instead of the sum of all
    three, which brings the whole card back under 300dp with the text at full size.

    Below 720dp of available width the columns would fall under ~190dp each and read worse than a
    single column, so layout/ carries a stacked variant with the same three ids and this file only
    applies above that. 720dp keeps every device we know about here: Mi A3 780dp, Mi9T 851dp,
    Nexus 7 960dp.

    The ScrollView stays as a safety net for a language that runs long or a shorter screen than
    we know about; it should not normally have anything to scroll.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="16dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header. Icon beside the title rather than above it: the stacked version cost 132dp,
             which was more than half the height budget on the shortest screen we support. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@color/material_orange_700"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_warning_white"
                app:tint="@android:color/white"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/disclaimer_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@android:color/white"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- wrap_content *and* a weight. On its own, wrap_content yields nothing: when the window
             hits the screen ceiling the ScrollView still claims the height its content wants and
             the accept button underneath gets clipped (seen on the Mi A3, 316dp). The weight lets
             LinearLayout take the shortfall out of this child instead, so the header and the
             button keep their size and the text scrolls by however much is missing. It cannot
             grow past its content either: inside a wrap_content parent the surplus is always
             zero, so there is nothing to distribute when the card does fit. -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <!-- One column per point. SafetyDisclaimerDialog splits the single translated
                     string on its paragraph break and fills these; if that ever yields something
                     other than three parts it falls back to point 1 spanning the full width. -->
                <TextView
                    android:id="@+id/disclaimer_point_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingMultiplier="1.1"
                    tools:text="1. Focus on the Road"/>

                <TextView
                    android:id="@+id/disclaimer_point_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingMultiplier="1.1"
                    tools:text="2. Limitation of Liability"/>

                <TextView
                    android:id="@+id/disclaimer_point_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnSurface"
                    android:lineSpacingMultiplier="1.1"
                    tools:text="3. No Affiliation"/>

            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:gravity="end"
            android:background="?attr/colorSurfaceVariant">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_accept"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/disclaimer_accept"
                android:textColor="@color/brand_on_accent"
                app:backgroundTint="@color/brand_accent"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
