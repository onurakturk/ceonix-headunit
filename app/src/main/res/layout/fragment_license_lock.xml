<?xml version="1.0" encoding="utf-8"?>
<!--
  Licence lock screen (Play build only; the GitHub build never shows it).

  Landscape-only and as short as 316dp on the Mi A3, so the text column scrolls and the buttons
  sit in one row underneath it. The head unit may be its own launcher, so this screen also has to
  give the rider a way out to the system: Wi-Fi settings (to get the one online check done) and the
  Play Store.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_m3_glow" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/license_icon"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginEnd="24dp"
                    android:background="@drawable/bg_setting_tile_icon"
                    android:backgroundTint="@color/m3_primary_cont"
                    android:padding="18dp"
                    android:src="@drawable/ic_m3_lock"
                    app:tint="@color/m3_on_primary_cont"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/license_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/m3_on_surface"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        tools:text="@string/license_lock_title_unverified" />

                    <TextView
                        android:id="@+id/license_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="@color/m3_on_surface_variant"
                        android:textSize="15sp"
                        tools:text="@string/license_lock_body_unverified" />

                    <TextView
                        android:id="@+id/license_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/m3_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="@string/license_lock_checking"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/license_verify"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="@string/license_lock_verify"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/brand_accent"
                android:textColor="@color/brand_on_accent"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/license_wifi"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/license_lock_wifi"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="@color/m3_on_surface"
                app:backgroundTint="@color/m3_surface_container_high"
                app:cornerRadius="28dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/license_play"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="@string/license_lock_play"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textColor="@color/m3_on_surface"
                app:backgroundTint="@color/m3_surface_container_high"
                app:cornerRadius="28dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
