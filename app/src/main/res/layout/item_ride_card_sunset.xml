<?xml version="1.0" encoding="utf-8"?>
<!--
    ALTITUDE + SUNSET page of the Ride screen's third card slot.

    The two readouts each own half the card, with the rule between them, so the divider sits on the
    card's centre line no matter how tall the two blocks happen to be. An earlier version shared the
    leftover space with two weighted gaps, which centred the rule between the blocks rather than in
    the card and left it about 6dp high.

    The sunset block was shrunk to make room: the clock dropped from 44sp to 30sp and its icon now
    sits on the same line instead of above, which alone gave back nearly 60dp. On the shortest
    screen (Mi A3) each half gets ~74dp against blocks of ~54dp and ~64dp.

    Root is match_parent/match_parent - ViewPager2 throws "Pages must fill the whole ViewPager2"
    otherwise. paddingEnd is 16dp because the pager insets 10dp to clear the card's accent bar.

    The top-right corner is reserved for the page indicator (see RideCardDotsView) - keep it empty,
    which is why the ALTITUDE heading sits alone on its line.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="16dp"
    android:paddingTop="18dp"
    android:paddingBottom="14dp">

    <!-- Top-aligned, and the card pads 18dp like the g-force one, so the ALTITUDE heading lands on
         exactly the same line as G-FORCE does on the neighbouring page. A heading belongs at the
         top of its card; the value and its trace keep their own arrangement below it. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ride_altitude"
            android:textColor="@color/m3_primary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <!-- The two flexible gaps centre the value and its trace in the space under the heading.
             The row itself stays bottom-aligned internally so the unit and the chart sit on the
             number's baseline rather than floating against its middle. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tv_altitude"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/m3_on_surface"
                android:textSize="30sp"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:fontFeatureSettings="tnum"
                tools:text="842" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_marginBottom="2dp"
                android:text="@string/ride_altitude_unit"
                android:textColor="@color/m3_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:includeFontPadding="false" />

            <com.andrerinas.headunitrevived.main.ride.AltitudeSparkView
                android:id="@+id/altitude_spark"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:layout_marginBottom="2dp" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/m3_outline"
        android:alpha="0.4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sunset"
            android:textColor="@color/m3_sunset"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.14" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_sunset_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/m3_on_surface"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:fontFeatureSettings="tnum"
                    tools:text="19:42" />

                <TextView
                    android:id="@+id/tv_sunset_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:textColor="@color/m3_sunset"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    tools:text="3h 22m left" />

            </LinearLayout>

            <!-- Both icons are the same box now; the headlight vector carries a group scale so the
                 two symbols also *look* the same size (see ic_m3_headlight.xml). -->
            <ImageView
                android:id="@+id/iv_headlight"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_m3_headlight"
                android:contentDescription="@string/sunset_headlights"
                android:visibility="gone"
                app:tint="@color/m3_headlight"
                tools:visibility="visible" />

            <ImageView
                android:id="@+id/iv_sunset"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_m3_night"
                android:contentDescription="@string/sunset"
                app:tint="@color/m3_sunset" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
