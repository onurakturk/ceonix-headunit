<?xml version="1.0" encoding="utf-8"?>
<!--
  One permission on the dashboard: what it is for, and whether it is satisfied.

  Same tonal-card language as the settings hub tile (layout_setting_nav_tile) — stroke-less,
  elevation 0, colour carried by the container — but the trailing chevron is replaced by a status
  glyph, because this row reports a state rather than leading somewhere.

  Kept compact on purpose: the head unit is landscape-only and the Mi A3 reports 332dp of height,
  so seven of these have to scroll without the pinned Continue button losing its place.
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/permission_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/m3_surface_container"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:rippleColor="?attr/colorAccent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/permission_icon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_setting_tile_icon"
            android:padding="14dp"
            android:tint="@color/m3_on_primary_cont"
            android:contentDescription="@null"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@drawable/ic_m3_gps" />

        <TextView
            android:id="@+id/permission_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/m3_on_surface"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/permission_icon"
            app:layout_constraintEnd_toStartOf="@id/permission_status"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/permission_description"
            app:layout_constraintVertical_chainStyle="packed"
            tools:text="Location" />

        <TextView
            android:id="@+id/permission_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="2dp"
            android:textColor="@color/m3_on_surface_variant"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end"
            app:layout_constraintStart_toEndOf="@id/permission_icon"
            app:layout_constraintEnd_toStartOf="@id/permission_status"
            app:layout_constraintTop_toBottomOf="@id/permission_title"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="Used for navigation and for working out the correct sunset time." />

        <ImageView
            android:id="@+id/permission_status"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="12dp"
            android:contentDescription="@null"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@drawable/ic_m3_check"
            tools:tint="@color/m3_headlight" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
