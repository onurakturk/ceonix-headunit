<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_buttons_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/m3_bg">

    <!-- Decorative radial glow -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_m3_glow"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ===== STATUS BAR ===== -->
    <LinearLayout
        android:id="@+id/status_bar"
        android:layout_width="0dp"
        android:layout_height="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/status_logo"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_ceonix_mark_mono"
            android:contentDescription="@string/app_name"
            app:tint="@color/m3_primary" />

        <TextView
            android:id="@+id/tv_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="@color/m3_on_surface"
            android:textSize="30sp"
            android:fontFamily="sans-serif-medium"
            tools:text="12:45" />

        <Space
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/gps_indicator"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_m3_chip"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="GPS"
            android:src="@drawable/ic_m3_gps"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/bt_indicator"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_m3_chip"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_m3_bt" />

        <ImageView
            android:id="@+id/theme_toggle"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_m3_chip"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/change_app_theme"
            android:src="@drawable/ic_m3_dark" />

        <View
            android:layout_width="1dp"
            android:layout_height="40dp"
            android:layout_marginStart="22dp"
            android:layout_marginEnd="8dp"
            android:alpha="0.4"
            android:background="@color/m3_outline" />

        <LinearLayout
            android:id="@+id/battery_pill"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="14dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="18dp"
            android:background="@drawable/bg_m3_pill">

            <com.andrerinas.headunitrevived.main.BatteryView
                android:id="@+id/battery_view"
                android:layout_width="20dp"
                android:layout_height="34dp"
                android:contentDescription="@string/battery" />

            <TextView
                android:id="@+id/tv_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/m3_on_surface_variant"
                android:textSize="18sp"
                android:fontFamily="sans-serif-medium"
                tools:text="82%" />

        </LinearLayout>

    </LinearLayout>

    <!-- ===== HOME TILES (edge-to-edge; content centered inside each card) ===== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/self_mode_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/m3_primary_cont"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/ride_button"
        app:layout_constraintHeight_percent="0.34"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/status_bar"
        app:layout_constraintVertical_bias="0.42"
        app:layout_constraintWidth_max="210dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/android_auto"
                android:src="@drawable/ic_m3_self"
                app:tint="@color/m3_on_primary_cont" />

            <TextView
                android:id="@+id/self_mode_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/android_auto"
                android:textColor="@color/m3_on_primary_cont"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ride_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/m3_ride_cont"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="@id/self_mode_button"
        app:layout_constraintEnd_toStartOf="@id/apps_button"
        app:layout_constraintHeight_percent="0.34"
        app:layout_constraintStart_toEndOf="@id/self_mode_button"
        app:layout_constraintTop_toTopOf="@id/self_mode_button"
        app:layout_constraintWidth_max="210dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/ride"
                android:src="@drawable/ic_m3_motorcycle"
                app:tint="@color/m3_on_ride_cont" />

            <TextView
                android:id="@+id/ride_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/ride"
                android:textColor="@color/m3_on_ride_cont"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/apps_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/m3_apps_cont"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="@id/self_mode_button"
        app:layout_constraintEnd_toStartOf="@id/settings_button"
        app:layout_constraintHeight_percent="0.34"
        app:layout_constraintStart_toEndOf="@id/ride_button"
        app:layout_constraintTop_toTopOf="@id/self_mode_button"
        app:layout_constraintWidth_max="210dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/apps"
                android:src="@drawable/ic_m3_apps"
                app:tint="@color/m3_on_apps_cont" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/apps"
                android:textColor="@color/m3_on_apps_cont"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/settings_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="24dp"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="@color/m3_neutral_cont"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="@id/self_mode_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.34"
        app:layout_constraintStart_toEndOf="@id/apps_button"
        app:layout_constraintTop_toTopOf="@id/self_mode_button"
        app:layout_constraintWidth_max="210dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/settings"
                android:src="@drawable/ic_settings_white"
                app:tint="@color/m3_on_neutral_cont" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/settings"
                android:textColor="@color/m3_on_neutral_cont"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- ===== EXIT ===== -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/exit_button"
        style="@style/Widget.Material3.Button.TonalButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:text="@string/exit"
        android:textColor="@color/m3_on_surface"
        android:textSize="18sp"
        app:backgroundTint="@color/m3_surface_container_high"
        app:cornerRadius="28dp"
        app:icon="@drawable/ic_m3_logout"
        app:iconGravity="textStart"
        app:iconTint="@color/m3_on_surface"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
