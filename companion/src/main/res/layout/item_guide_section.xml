<?xml version="1.0" encoding="utf-8"?>
<!-- "On the head unit" / "On this phone": tells the rider which screen to look at next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="28dp"
    android:layout_marginBottom="4dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/section_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_setting_tile_icon"
        android:contentDescription="@null"
        android:padding="11dp"
        app:tint="@color/m3_on_primary_cont" />

    <TextView
        android:id="@+id/section_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:textColor="@color/m3_on_surface"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
